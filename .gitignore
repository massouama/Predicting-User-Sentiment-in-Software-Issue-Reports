# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# OS / editor
.DS_Store
.idea/
.vscode/

# Trained model artefacts (regenerated by the pipeline; can be large)
results/models/*.joblib

# Transient pipeline artefacts (regenerated on every run)
results/.joblib_cache/
results/run_log.txt

# Raw app-review download (~40 MB); the processed sample is committed instead
data/reviews_raw.csv

# NLTK data downloaded at runtime
nltk_data/
